<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingTop="18dp"
        android:paddingRight="18dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="爱优腾"
                android:textColor="@color/text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/avtpStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="选频道，或直接搜剧名"
                android:textColor="@color/text2"
                android:textSize="11.5sp" />
        </LinearLayout>

        <Button
            android:id="@+id/avtpBtnPaste"
            style="@style/Chip"
            android:text="粘贴解析" />
    </LinearLayout>

    <!-- 平台 Tab -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/avtpTabIqiyi"
            style="@style/PlatformTab"
            android:text="爱奇艺" />

        <Button
            android:id="@+id/avtpTabYouku"
            style="@style/PlatformTab"
            android:layout_marginLeft="8dp"
            android:text="优酷" />

        <Button
            android:id="@+id/avtpTabQq"
            style="@style/PlatformTab"
            android:layout_marginLeft="8dp"
            android:text="腾讯" />
    </LinearLayout>

    <!-- 搜索 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/avtpSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="搜剧名 / 演员"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text3"
            android:textSize="13.5sp" />

        <Button
            android:id="@+id/avtpBtnSearch"
            style="@style/PrimaryButton"
            android:layout_width="76dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:text="搜索" />
    </LinearLayout>

    <!-- 筛选 chips -->
    <HorizontalScrollView
        android:id="@+id/avtpChipBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="2dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/avtpChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp" />
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/avtpLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_marginTop="6dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/avtpGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="16dp" />
</LinearLayout>
