<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_bg">

    <FrameLayout
        android:id="@+id/avtpProbeHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.shuyu.gsyvideoplayer.video.StandardGSYVideoPlayer
        android:id="@+id/avtpPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/avtpBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_gravity="top"
        android:indeterminate="true"
        android:indeterminateTint="@color/player_accent"
        android:visibility="gone" />

    <!-- 顶部胶囊：选集 / 上一集 / 下一集 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <Button
            android:id="@+id/avtpBtnPrev"
            style="@style/Chip"
            android:layout_height="30dp"
            android:layout_marginLeft="2dp"
            android:background="#00000000"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="上一集"
            android:textColor="#FFD8DCE2"
            android:textSize="11.5sp" />

        <Button
            android:id="@+id/avtpBtnNext"
            style="@style/Chip"
            android:layout_height="30dp"
            android:layout_marginLeft="2dp"
            android:background="#00000000"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="下一集"
            android:textColor="#FFD8DCE2"
            android:textSize="11.5sp" />

        <View
            android:id="@+id/avtpDivider"
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="#33FFFFFF" />

        <Button
            android:id="@+id/avtpBtnEps"
            style="@style/Chip"
            android:layout_height="30dp"
            android:layout_marginRight="2dp"
            android:background="#00000000"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="选集"
            android:textColor="@color/player_accent"
            android:textSize="11.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/avtpLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="26dp">

        <ProgressBar
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:indeterminateTint="@color/player_accent" />

        <TextView
            android:id="@+id/avtpStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="#FFD5D9DF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 选集面板 -->
    <LinearLayout
        android:id="@+id/avtpEpsPanel"
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_panel_top"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/avtpEpsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingBottom="10dp"
            android:text="选集"
            android:textColor="@color/text2"
            android:textSize="11.5sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/avtpEpsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </ScrollView>
    </LinearLayout>

    <!-- 线路面板 -->
    <LinearLayout
        android:id="@+id/avtpLinePanel"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/avtpCurrentLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text2"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/avtpLineList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <Button
        android:id="@+id/avtpBtnLines"
        style="@style/PrimaryButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="22dp"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:text="线路"
        android:textSize="13sp" />
</FrameLayout>
