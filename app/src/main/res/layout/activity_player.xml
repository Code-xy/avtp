<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- WebView 抓流探针：垫在最底层，被上面的播放器盖住。
         必须给足尺寸 —— 1x1 会让部分播放器页的 JS 布局/检测失效。 -->
    <FrameLayout
        android:id="@+id/probeHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.shuyu.gsyvideoplayer.video.StandardGSYVideoPlayer
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:indeterminate="true"
        android:indeterminateTint="#4DA3FF"
        android:visibility="gone" />

    <!-- 顶部操作条：选集 / 上一集 / 下一集 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:background="#B316171B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="#00000000"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="上一集"
            android:textColor="#E8E8E8"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="#00000000"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="下一集"
            android:textColor="#E8E8E8"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnEps"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="#00000000"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="选集"
            android:textColor="#4DA3FF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 加载/状态 -->
    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="#4DA3FF" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="#DDDDDD"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 选集面板 -->
    <LinearLayout
        android:id="@+id/epsPanel"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="#F216171B"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/epsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingBottom="6dp"
            android:text="选集"
            android:textColor="#8A8A8E"
            android:textSize="11sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/epsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />
        </ScrollView>
    </LinearLayout>

    <!-- 线路面板 -->
    <LinearLayout
        android:id="@+id/linePanel"
        android:layout_width="248dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="86dp"
        android:background="#F216171B"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/currentLineText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp"
            android:textColor="#8A8A8E"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/lineList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <Button
        android:id="@+id/btnLines"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="20dp"
        android:minWidth="0dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:text="线路"
        android:textSize="13sp" />
</FrameLayout>
